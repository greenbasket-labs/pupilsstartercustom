# Supabase project URL (safe to expose to the browser if needed)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service-role key. SERVER ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase publishable key. Safe for browser/client authentication; not a secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
